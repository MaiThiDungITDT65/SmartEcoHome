# Smart Eco Garden Backend Configuration

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Device Inactivity Timeout (seconds) before marking device as offline
TELEMETRY_TIMEOUT_SECONDS=30

# Periodic interval (seconds) for checking offline status transition
TIMEOUT_CHECK_INTERVAL_SECONDS=1.0

# Optional API Key for POST /api/telemetry (leave empty to disable authentication)
TELEMETRY_API_KEY=
